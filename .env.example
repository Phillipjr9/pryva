# Pryva environment template.
#
# Copy to `.env.local` for local development, or set these in your host's
# dashboard (Vercel → Project → Settings → Environment Variables) for production.
#
#   cp .env.example .env.local
#
# NEVER commit a filled-in copy. `.gitignore` excludes `.env` and `.env.*`; only
# this template is tracked. Every value below is a placeholder.

# ─────────────────────────────────────────────────────────────────────────────
# Required — the app does not boot usefully without these
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Leave UNSET in local development to run against the in-process demo database.
# Setting this to a real database turns off the demo lane entirely.
DATABASE_URL=

# Canonical public origin, used for CSRF checks on mutations and for absolute
# links in email and sitemaps. Include the scheme, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─────────────────────────────────────────────────────────────────────────────
# Accounts marketplace — this is what makes stock sellable
# ─────────────────────────────────────────────────────────────────────────────

# Setting this key is what switches live purchasing on. No separate feature flag
# is needed and none should be added: as soon as a key is present, checkout buys
# from the source for real. Leave it unset until the upstream account is funded,
# because an order placed against an unfunded balance fails at the source and
# leaves the customer's wallet debited pending reconciliation.
BULKACC_API_KEY=
# Optional. Only set to point at a different deployment of the same API.
BULKACC_API_URL=

# Legacy fallback source for account listings. Kept deliberately — it is the only
# source that supports promo codes. Requires MARKETPLACE_LIVE_PURCHASES below.
ACCSZONE_API_KEY=
ACCSZONE_API_URL=

# Gate for the FALLBACK source only. The primary source above ignores this flag.
# Set to "true" to let the fallback fulfil real purchases.
MARKETPLACE_LIVE_PURCHASES=false

# Verification, virtual number, eSIM, proxy and email-OTP services.
FLEEXA_API_KEY=
# FLEEXA_API_URL is accepted as a legacy alias of FLEEXA_BASE_URL.
FLEEXA_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Pricing — all optional, these are the defaults
# ─────────────────────────────────────────────────────────────────────────────

# Naira per US dollar. Pinned rates bypass the live lookup; the fallback is used
# only when the lookup fails.
USD_NGN_RATE=
USD_NGN_FALLBACK=1600

# Margin controls. Default markup 38% within a 30–50% band, and no listing is
# priced below a ₦200 profit.
MARKETPLACE_BASE_MARKUP_PERCENT=
MARKETPLACE_MIN_PROFIT_NGN=

# ─────────────────────────────────────────────────────────────────────────────
# Customer policy
# ─────────────────────────────────────────────────────────────────────────────

# Replacement window for any product group without its own row. Streaming and
# video carry longer windows in code, so this only affects the remainder.
WARRANTY_DEFAULT_DAYS=30

# ─────────────────────────────────────────────────────────────────────────────
# Payments — Paystack
# ─────────────────────────────────────────────────────────────────────────────

# Use sk_test_... while testing. A test key automatically forces wallet email
# into test mode, so no customer mail is sent from a test environment.
PAYSTACK_SECRET_KEY=

# Optional override for the origin used to build the top-up return URL
# (/dashboard/wallet?topup=return). Leave unset and it falls back to
# NEXT_PUBLIC_SITE_URL, which is what you want unless the wallet is served from a
# different origin than the rest of the site. Setting both to conflicting values
# sends customers back to the wrong domain after paying.
NEXT_PUBLIC_APP_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Transactional email — Resend
# ─────────────────────────────────────────────────────────────────────────────

# Requires migration 0005 applied, a verified sending domain, and a server-only
# key. Leave unset and mail stays queued rather than failing.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Forces wallet mail into test mode regardless of the payment key.
WALLET_EMAIL_TEST_MODE=

# ─────────────────────────────────────────────────────────────────────────────
# Auth and admin
# ─────────────────────────────────────────────────────────────────────────────

# Google OAuth. Optional — email and password sign-in works without them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of addresses allowed into /admin.
ADMIN_EMAILS=

# ─────────────────────────────────────────────────────────────────────────────
# Scheduled jobs
# ─────────────────────────────────────────────────────────────────────────────

# Shared bearer token for the auto-refund, scheduled-orders and wallet-email
# cron routes. Without it those routes refuse every caller.
#
# Note: Vercel Hobby cron runs at most once daily with ±59 minutes of drift, so
# the wallet mail retry window needs Pro or an external scheduler.
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Provided by the platform — do not set these yourself
# ─────────────────────────────────────────────────────────────────────────────
#
# NODE_ENV, NEXT_DEPLOYMENT_ID, VERCEL_GIT_COMMIT_SHA, GITHUB_SHA and
# E2B_SANDBOX_ID are injected by the runtime, the host or CI. They are read by
# the app but must not appear in a filled-in environment file.
