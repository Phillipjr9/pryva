# Pryva environment template.
#
# Copy to `.env.local` for local development, or set these in your host's
# dashboard (Vercel → Project → Settings → Environment Variables) for production.
#
#   cp .env.example .env.local
#
# NEVER commit a filled-in copy. `.gitignore` excludes `.env` and `.env.*`; only
# this template is tracked. Every value below is a placeholder.

# ─────────────────────────────────────────────────────────────────────────────
# Required — the app does not boot usefully without these
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Leave UNSET in local development to run against the in-process demo database.
# Setting this to a real database turns off the demo lane entirely.
DATABASE_URL=

# Certificate verification for the AWS RDS IAM connection path -- the PGHOST /
# PGUSER / AWS_ROLE_ARN variables injected by the Vercel + Aurora integration.
# Verification is ON by default. Set to exactly 1 to accept an unverified
# certificate, for a local or debugging setup where the RDS CA bundle is not
# available. Leave it unset in production: turning it off removes the guarantee
# that you are talking to your own database rather than something intercepting
# the connection. Read only by src/db/aws-iam.ts, so it has no effect on a
# DATABASE_URL connection.
PGSSL_NO_VERIFY=

# Injected by the Vercel + Aurora (RDS IAM) integration -- do NOT set these by
# hand, and do not expect to find them in a copied .env.local. There is no
# database password anywhere in this setup: the connection authenticates with a
# short-lived IAM token minted from AWS_ROLE_ARN through Vercel's OIDC
# federation, cached for just under the 15 minutes it stays valid.
#
#   Read by src/:  AWS_REGION  AWS_ROLE_ARN
#                  PGHOST  PGPORT  PGUSER  PGDATABASE  PGSSLMODE
#   Also injected, unused by src/:  AWS_ACCOUNT_ID  AWS_RESOURCE_ARN
#
# Setting DATABASE_URL above switches to the plain connection-string path and
# the IAM variables are ignored. Never set both and assume you know which won.

# Canonical public origin, used for CSRF checks on mutations and for absolute
# links in email and sitemaps. Include the scheme, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─────────────────────────────────────────────────────────────────────────────
# Accounts marketplace — this is what makes stock sellable
# ─────────────────────────────────────────────────────────────────────────────

# Setting this key is what switches live purchasing on. No separate feature flag
# is needed and none should be added: as soon as a key is present, checkout buys
# from the source for real. Leave it unset until the upstream account is funded,
# because an order placed against an unfunded balance fails at the source and
# leaves the customer's wallet debited pending reconciliation.
BULKACC_API_KEY=
# Optional. Only set to point at a different deployment of the same API.
BULKACC_API_URL=

# Legacy fallback source for account listings. Kept deliberately — it is the only
# source that supports promo codes. Requires MARKETPLACE_LIVE_PURCHASES below.
ACCSZONE_API_KEY=
ACCSZONE_API_URL=

# Gate for the FALLBACK source only. The primary source above ignores this flag.
# Set to "true" to let the fallback fulfil real purchases.
MARKETPLACE_LIVE_PURCHASES=false

# Verification, virtual number, eSIM, proxy and email-OTP services.
FLEEXA_API_KEY=
# FLEEXA_API_URL is accepted as a legacy alias of FLEEXA_BASE_URL.
FLEEXA_BASE_URL=

# Temporary / Disposable Inboxes
# "tempmail": Zero-setup public disposable email (fakemailo style). No domain, MX, or API key needed.
# "fleexa": Wholesale email provider via fleexa.com.ng (requires FLEEXA_API_KEY and NGN balance).
# Defaults to "tempmail" when FLEEXA_API_KEY is omitted so temporary inboxes work out of the box.
INBOX_PROVIDER=tempmail

# Social boosting (followers, likes, views, subscribers) via an SMM panel.
# Panel-agnostic: any panel exposing the common "API v2" contract works, and the
# catalog is read from the panel at runtime rather than hardcoded, so service
# identifiers do not need to be configured here.
#
# BOTH variables are required. A key with no endpoint has nowhere to be sent, and
# the endpoint is validated as https with no embedded credentials and never an
# internal host. Unlike the marketplace key above, setting these does NOT switch
# on purchasing by itself: a listing also needs a retail price, which comes from
# SMM_MARKUP_PERCENT below (and, for a USD-billed panel, SMM_USD_NGN_RATE).
# Without a price the listing stays read-only and cannot be bought.
#
# Billing currency is read from the panel's own responses rather than assumed.
# Panels bill either NGN or USD, and which one you get determines the retail
# pricing and the FX exposure, so confirm it with action=balance before choosing
# a supplier. Do not fund a panel before a single minimum-size test order has
# been placed and its status read back.
SMM_PANEL_API_KEY=
SMM_PANEL_API_URL=

# Retail margin on boosting, in percent. Defaults to 35. This is the owner's
# pricing decision, not a per-request guess: retail per 1,000 =
# ceil(wholesale x (1 + margin) x fx), rounded up to whole naira.
SMM_MARKUP_PERCENT=35

# Naira per US dollar, ONLY if the panel bills in USD. There is no default on
# purpose — converting with an invented exchange rate quietly loses money every
# time the naira moves, so a USD panel with this unset has no price and cannot be
# bought. A panel that bills NGN needs nothing here.
SMM_USD_NGN_RATE=

# eSIM data plans, plus OTP and HLR, through one gateway (docs.bitcall.io).
# TWO credentials, not one: a key id (ak_test_… or ak_live_…) and a 128-hex
# secret sent as separate headers on every request. Both are required.
#
# The secret authorizes every endpoint the key can reach, purchases included,
# and cannot be read back once issued. It travels as a header, so anything that
# records request headers captures it. Set an IP allowlist on the key in their
# panel: that narrows where a leaked secret can be used. Rotation is immediate
# with no overlap, so for a planned change deploy a second key first.
#
# Setting these switches on READ-ONLY eSIM listings. It does not switch on
# purchasing, for two reasons that are decisions rather than gaps:
#   1. Their catalog returns plans "at your selling prices", which does not say
#      whether that figure is our cost (needing markup) or a suggested retail
#      price (needing none). Pricing is left unset until that is confirmed.
#   2. Their purchase endpoint spends money on every call and has no idempotency
#      key, so the order flow is wired only once a test key has proven it.
# Prefer an ak_test_ key first and confirm with them what that environment costs.
BITCALL_KEY_ID=
BITCALL_API_SECRET=
# Optional. May point at a different deployment of the same gateway, but the
# hostname is pinned to api.bitcall.io and anything else is refused.
BITCALL_API_URL=

# Digital retail gift cards and gaming vouchers via FoxReload.
# Authentication requires the X-API-Key header.
FOXRELOAD_API_KEY=
# Optional. Defaults to https://public-api.foxreload.com.
FOXRELOAD_BASE_URL=
# Set to "true" to process orders through FoxReload's mock marketplace for testing.
FOXRELOAD_IS_MOCK=false

# ─────────────────────────────────────────────────────────────────────────────
# Pricing — all optional, these are the defaults
# ─────────────────────────────────────────────────────────────────────────────

# Naira per US dollar. Pinned rates bypass the live lookup; the fallback is used
# only when the lookup fails.
USD_NGN_RATE=
USD_NGN_FALLBACK=1600

# Margin controls. Default markup 38% within a 30–50% band, and no listing is
# priced below a ₦200 profit.
MARKETPLACE_BASE_MARKUP_PERCENT=
MARKETPLACE_MIN_PROFIT_NGN=

# ─────────────────────────────────────────────────────────────────────────────
# Customer policy
# ─────────────────────────────────────────────────────────────────────────────

# Replacement window for any product group without its own row. Streaming and
# video carry longer windows in code, so this only affects the remainder.
WARRANTY_DEFAULT_DAYS=30

# ─────────────────────────────────────────────────────────────────────────────
# Payments — Paystack
# ─────────────────────────────────────────────────────────────────────────────

# Use sk_test_... while testing. A test key forces wallet email into test mode,
# but test mode LABELS mail rather than withholding it: every subject is
# prefixed "[TEST] " and the body opens with "TEST MODE — no real payment or
# payout." The message is still delivered to the customer's real address once
# Resend is configured. Only the public key is unused — this app initializes
# checkout server-side, so PAYSTACK_SECRET_KEY is the only Paystack variable.
PAYSTACK_SECRET_KEY=

# Optional override for the origin used to build the top-up return URL
# (/dashboard/wallet?topup=return). Leave unset and it falls back to
# NEXT_PUBLIC_SITE_URL, which is what you want unless the wallet is served from a
# different origin than the rest of the site. Setting both to conflicting values
# sends customers back to the wrong domain after paying.
NEXT_PUBLIC_APP_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Transactional email — Resend
# ─────────────────────────────────────────────────────────────────────────────

# Requires migration 0005 applied, a verified sending domain, and a server-only
# key. Leave unset and mail stays queued rather than failing.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Forces wallet mail into test mode regardless of the payment key.
WALLET_EMAIL_TEST_MODE=

# ─────────────────────────────────────────────────────────────────────────────
# Auth and admin
# ─────────────────────────────────────────────────────────────────────────────

# Google OAuth. Optional — email and password sign-in works without them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of addresses allowed into /admin.
ADMIN_EMAILS=

# Where high-severity fraud alerts are emailed. Optional: when unset, alerts go to
# the addresses above instead, so a deployment that only configures ADMIN_EMAILS
# still hears about a flagged withdrawal. Never sent to the customer involved.
# Up to five addresses; comma, semicolon or space separated.
FRAUD_ALERT_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# Two-factor authentication
# ─────────────────────────────────────────────────────────────────────────────

# Encrypts stored TOTP secrets (AES-256-GCM, key derived with scrypt). At least
# 16 characters; treat it as a passphrase, not a key, and generate it randomly.
#
# Leave it UNSET to keep 2FA unavailable: enrolment is refused, and an account
# that already has it enabled is refused at sign-in with a 503 and no session.
# That is deliberate — the alternative would be silently dropping a customer back
# to a password-only login without telling them.
#
# Rotating this value makes every existing enrolment unreadable and locks those
# accounts out of their second step. RUNBOOK.md has the recovery procedure.
TWO_FACTOR_KEY=
# Administrator accounts must enrol a second factor before the admin tools open.
# Set to "false" only to recover a locked-out administrator, then set it back.
ADMIN_2FA_REQUIRED=true

# ─────────────────────────────────────────────────────────────────────────────
# Passkeys (WebAuthn) — optional; sign-in works without it
# ─────────────────────────────────────────────────────────────────────────────
# A passkey lets a customer sign in with their fingerprint, face or device PIN
# instead of a password, and it satisfies the second factor on its own.
#
# WebAuthn needs a secure origin, so the server has to know which origin to sign
# for rather than believe an inbound Host header. Leave WEBAUTHN_ORIGIN unset and
# it falls back to NEXT_PUBLIC_SITE_URL (recommended), and only then to the
# request's own origin — which is what makes localhost:3000 work in development.
# WEBAUTHN_ORIGIN=https://your-domain.com
#
# Optional, and only needed when passkeys must cover a parent domain or a
# subdomain set (e.g. "your-domain.com" for app.your-domain.com). It must be a
# suffix of the origin above or the ceremony is refused rather than half-working.
# WEBAUTHN_RP_ID=your-domain.com

# ─────────────────────────────────────────────────────────────────────────────
# Referrals — on by default, at the rate the owner approved
# ─────────────────────────────────────────────────────────────────────────────
# A customer shares a code or link; when the invited account's first order is
# delivered, the inviter is credited a share of it in their wallet, once per
# invited account. The defaults below are the approved offer (5%, capped at
# ₦2,000) — change them here rather than in code, and set the percentage to 0 to
# switch the programme off without a deploy.
# REFERRAL_REWARD_PERCENT=5
# REFERRAL_REWARD_CAP_NGN=2000

# ─────────────────────────────────────────────────────────────────────────────
# Fraud signals — needs no configuration, but the salt matters
# ─────────────────────────────────────────────────────────────────────────────
# Signup signals are stored as salted SHA-256 hashes so two accounts can be
# compared without keeping an address anywhere. Change this only deliberately:
# rotating it makes every hash already stored incomparable with new ones, which
# loses the "same network?" check for accounts created before the change.
# FRAUD_HASH_SALT=change-me-before-you-go-live

# ─────────────────────────────────────────────────────────────────────────────
# Scheduled jobs
# ─────────────────────────────────────────────────────────────────────────────

# Shared bearer token for the auto-refund, scheduled-orders and wallet-email
# cron routes. Without it those routes refuse every caller.
#
# Note: Vercel Hobby cron runs at most once daily with ±59 minutes of drift, so
# the wallet mail retry window needs Pro or an external scheduler.
CRON_SECRET=

# Read-only integration probe credential. Deliberately separate from CRON_SECRET:
# `/api/diagnostics/integrations` reports supplier balances and samples, and a
# read-only endpoint must not share a credential with jobs that credit wallets and
# send mail — rotating one should not silently open the other. Set it as a
# sensitive value in the host; it authorises reads only.
DIAGNOSTICS_SECRET=

# Retention sweep for accounts that were closed by their owner.
#
# Closed accounts keep their records for ten years (the horizon in
# `src/lib/retention.ts`) and then become eligible for removal. The nightly job
# always counts how many are due; this flag is what allows it to delete them, and
# it is **off** unless set to exactly `true`. Deleting a closed account removes its
# orders, ledger, payouts and the closure receipt with it (they cascade), so arming
# this is a deliberate act, not a default that arrives with a deploy.
RETENTION_PURGE_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# Margin protection
# ─────────────────────────────────────────────────────────────────────────────
#
# Optional. Minimum gross margin, as a fraction of the selling price, that a
# live purchase must clear. Defaults to 0.1 (10%) when unset.
#
# Fulfilment spends your real provider balance, and nothing else in the purchase
# path compares what the customer pays against what the unit costs. Before
# buying, Pryva quotes the provider's price for the exact destination and
# refuses the sale — charging nothing and buying nothing — when that quote is
# missing, at or above your price, or below this floor. A malformed or
# out-of-range value is ignored in favour of the default, so it can never widen
# what is allowed to sell.
#
# Raise it to protect margin more aggressively; the catalog targets 30-50%.
MIN_MARGIN_RATIO=

# ─────────────────────────────────────────────────────────────────────────────
# Support assistant — optional prose model
# ─────────────────────────────────────────────────────────────────────────────
#
# The support assistant decides everything from the database: it reads the
# account, picks an explanation, runs a fix and verifies the fix. That part needs
# no configuration and no network.
#
# These three switch on a language model whose ONLY job is to re-word a reply
# that has already been decided. Off unless AI_SUPPORT_MODEL_ENABLED is exactly
# "true" AND a key is present. With them off, the deterministic wording is used.
#
# Turning this on sends the drafted reply — which contains the customer's own
# words and their amounts — to the provider named in AI_SUPPORT_BASE_URL. It
# never sends the account: no name, no email, no reference. That trade-off is
# yours to make, which is why it is not switched on here.
AI_SUPPORT_MODEL_ENABLED=
AI_SUPPORT_API_KEY=
# OpenAI-compatible endpoint, no trailing slash. Defaults to https://api.openai.com/v1
AI_SUPPORT_BASE_URL=
# Defaults to gpt-4o-mini
AI_SUPPORT_MODEL=

# ─────────────────────────────────────────────────────────────────────────────
# Provided by the platform — do not set these yourself
# ─────────────────────────────────────────────────────────────────────────────
#
# NODE_ENV, NEXT_DEPLOYMENT_ID, VERCEL_GIT_COMMIT_SHA, GITHUB_SHA and
# E2B_SANDBOX_ID are injected by the runtime, the host or CI. They are read by
# the app but must not appear in a filled-in environment file.
